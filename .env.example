# Set the key for the hosted backend you want to use.
OPENAI_API_KEY=replace-me

# Optional overrides used by src/simple_examples/scripts/run_openai.sh
OPENAI_MODEL=gpt-5-mini

# Optional overrides used by src/simple_examples/scripts/run_qwen.sh
QWEN_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434/v1

# OpenRouter (independent of the OpenAI key above)
OPENROUTER_API_KEY=replace-me
OPENROUTER_MODEL=openai/gpt-4o-mini
